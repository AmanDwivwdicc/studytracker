{
  "name": "study-tracker-web",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "description": "AI powered study monitoring web application - detects sleeping and mobile phone use with a laptop webcam, USB camera or RTSP IP camera. Runs fully offline.",
  "scripts": {
    "postinstall": "node scripts/copy-wasm.mjs",
    "dev": "concurrently -k -n SERVER,WEB -c blue,green \"npm:dev:server\" \"npm:dev:web\"",
    "dev:server": "node server/index.js",
    "dev:web": "vite",
    "dev:vite": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "start": "node server/index.js",
    "test": "node scripts/test.mjs"
  },
  "keywords": [
    "study-tracker",
    "computer-vision",
    "mediapipe",
    "yolo",
    "rtsp"
  ],
  "license": "MIT",
  "engines": {
    "node": ">=20.19.0"
  },
  "dependencies": {
    "@mediapipe/tasks-vision": "^1.2.2",
    "express": "^5.3.0",
    "ffmpeg-static": "^5.3.0",
    "jpeg-js": "^0.4.4",
    "onnxruntime-node": "^1.31.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "ws": "^8.22.2"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^6.3.0",
    "concurrently": "^10.0.7",
    "vite": "^8.3.8"
  }
}
